app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Reference implementation dropped in for study — NOT part of this project.
# (Contains node_modules, a keystore, and binaries — never commit.)
/dexchatsminermulti/

# Bee Engine — the upstream Rust source clone is not vendored here.
# The built WASM SDK in assets/bee/pkg/ IS committed so CI builds are
# self-contained; regenerate it with tool/sync_bee_sdk.sh.
/bee-engine/

# Android release signing — never commit these. CI writes key.properties from
# repo secrets; keep your keystore backed up somewhere safe outside git.
/android/key.properties
*.jks
*.keystore
*.p12
SECRETS.txt
